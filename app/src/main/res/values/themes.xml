    <style name="Theme.VoiceVault" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Opaque on purpose: a genuinely translucent window reveals whatever else is in this
         activity's task underneath it (e.g. MainActivity, if one happens to be there), which
